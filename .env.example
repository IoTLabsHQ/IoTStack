# Copy this file to .env and fill in real values before deploying.

# Dashboard admin account, seeded on first boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=changeme_generate_a_real_secret

# Controller account used by the api service to manage MQTT credentials via
# Mosquitto's Dynamic Security plugin — not a dashboard/human account.
# Generate a real password with: openssl rand -base64 24
DYNSEC_CONTROLLER_USERNAME=iotstack_controller
DYNSEC_CONTROLLER_PASSWORD=changeme_generate_a_real_secret

# Per-device limits (no plan tiers — one flat set of limits for the whole instance)
RATE_LIMIT_MSG_PER_MIN=60
STORAGE_CAP_MB=500
RAW_RETENTION_DAYS=14

# How often the api service polls the resource-monitoring agent (host +
# per-service CPU/RAM/disk). Warning/critical thresholds are configured
# from the dashboard's Resources page, not here.
RESOURCE_POLL_INTERVAL_SECONDS=30
