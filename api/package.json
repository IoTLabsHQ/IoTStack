{
  "name": "iotstack-api",
  "version": "1.6.0",
  "private": true,
  "description": "REST API, MQTT credential management, and message collector for IoTStack",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:acl": "tsx src/scripts/migrate-device-acl.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mqtt": "^5.10.1",
    "multer": "^2.3.0",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
